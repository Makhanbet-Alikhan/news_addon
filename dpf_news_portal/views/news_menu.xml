<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Root app menu -->
        <menuitem id="menu_news_main_app"
                  name="News Portal"
                  sequence="150"
                  web_icon="dpf_news_portal,static/description/icon.svg"/>

        <!-- Posts submenu -->
        <menuitem id="menu_news_posts"
                  name="Posts"
                  parent="menu_news_main_app"
                  sequence="10"/>
        <menuitem id="menu_news_all_posts"
                  name="All Posts"
                  parent="menu_news_posts"
                  action="dpf_news_portal.action_news_post"
                  sequence="5"/>
        <menuitem id="menu_news_type_news"
                  name="News"
                  parent="menu_news_posts"
                  action="dpf_news_portal.action_news_post_type_news"
                  sequence="10"/>
        <menuitem id="menu_news_type_announcements"
                  name="Announcements"
                  parent="menu_news_posts"
                  action="dpf_news_portal.action_news_post_type_announcements"
                  sequence="20"/>
        <menuitem id="menu_news_type_pre_releases"
                  name="Pre-releases"
                  parent="menu_news_posts"
                  action="dpf_news_portal.action_news_post_type_pre_releases"
                  sequence="30"/>

        <!-- Social submenu -->
        <menuitem id="menu_news_social"
                  name="Social"
                  parent="menu_news_main_app"
                  sequence="20"/>
        <menuitem id="menu_news_social_config"
                  name="Social Settings"
                  parent="menu_news_social"
                  action="dpf_news_portal.action_dpf_social_config"
                  sequence="10"/>
        <menuitem id="menu_news_social_log"
                  name="Publish Log"
                  parent="menu_news_social"
                  action="dpf_news_portal.action_news_social_log"
                  sequence="20"/>
    </data>
</odoo>
