<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Actions ──────────────────────────────────────────────────────── -->
    <record id="action_news_post" model="ir.actions.act_window">
        <field name="name">All News</field>
        <field name="res_model">news.post</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_news_post_type_news" model="ir.actions.act_window">
        <field name="name">News</field>
        <field name="res_model">news.post</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('news_type', '=', 'news')]</field>
        <field name="context">{'default_news_type': 'news'}</field>
    </record>
    <record id="action_news_post_type_announcements" model="ir.actions.act_window">
        <field name="name">Announcements</field>
        <field name="res_model">news.post</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('news_type', '=', 'announcements')]</field>
        <field name="context">{'default_news_type': 'announcements'}</field>
    </record>
    <record id="action_news_post_type_pre_releases" model="ir.actions.act_window">
        <field name="name">Pre-releases</field>
        <field name="res_model">news.post</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('news_type', '=', 'pre_releases')]</field>
        <field name="context">{'default_news_type': 'pre_releases'}</field>
    </record>

    <!-- ── List view ─────────────────────────────────────────────────────── -->
    <record id="view_news_post_list" model="ir.ui.view">
        <field name="name">news.post.list</field>
        <field name="model">news.post</field>
        <field name="arch" type="xml">
            <list string="News Posts">
                <field name="name"/>
                <field name="news_type"/>
                <field name="date"/>
                <field name="is_published" widget="boolean_toggle"/>
                <field name="social_status" widget="badge"
                       decoration-success="social_status == 'sent'"
                       decoration-warning="social_status == 'partial'"
                       decoration-danger="social_status == 'error'"
                       decoration-muted="social_status == 'not_sent'"/>
            </list>
        </field>
    </record>

    <!-- ── Form view ─────────────────────────────────────────────────────── -->
    <record id="view_news_post_form" model="ir.ui.view">
        <field name="name">news.post.form</field>
        <field name="model">news.post</field>
        <field name="arch" type="xml">
            <form string="News Post">
                <header>
                    <button name="website_publish_button" type="object"
                            string="Publish" class="btn-primary"
                            invisible="is_published"/>
                    <button name="website_publish_button" type="object"
                            string="Unpublish" class="btn-secondary"
                            invisible="not is_published"/>
                    <!-- Open social wizard: action defined in wizard_views loaded first -->
                    <button name="action_open_social_wizard" type="object"
                            string="📢 Send to Social" class="btn-secondary"
                            invisible="not is_published"/>
                    <field name="is_published" widget="boolean_toggle" nolabel="1"
                           options="{'terminology': 'archive'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Published"   bg_color="text-bg-success" invisible="not is_published"/>
                    <widget name="web_ribbon" title="Unpublished" bg_color="text-bg-danger"  invisible="is_published"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="News Title..." required="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="news_type" widget="radio"/>
                            <field name="is_published" invisible="1"/>
                        </group>
                        <group>
                            <field name="social_auto_publish" widget="boolean_toggle"/>
                            <field name="social_status" widget="badge"
                                   decoration-success="social_status == 'sent'"
                                   decoration-warning="social_status == 'partial'"
                                   decoration-danger="social_status == 'error'"
                                   decoration-muted="social_status == 'not_sent'"/>
                            <div class="d-flex align-items-center mt-2">
                                <button type="object" name="open_website_url"
                                        string="Open on Website"
                                        class="btn btn-secondary btn-sm"
                                        icon="fa-globe"/>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="content" widget="html"/>
                        </page>
                        <page string="Images" name="images">
                            <field name="image_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="image" widget="image" options="{'size': [90, 90]}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Gallery Settings" name="gallery">
                            <group string="Layout">
                                <field name="gallery_layout" widget="radio"/>
                            </group>
                            <group string="Side mode settings" invisible="gallery_layout == 'bottom'">
                                <field name="main_image_width" string="Main photo width (%)"/>
                                <div colspan="2" class="text-muted small" style="padding:4px 8px;">
                                    💡 Thumbnail width = 100% minus main photo width
                                </div>
                            </group>
                            <group string="Bottom mode settings" invisible="gallery_layout == 'side'">
                                <field name="main_image_height" string="Main photo height (px)"/>
                                <field name="thumb_height"      string="Thumbnail height (px)"/>
                            </group>
                        </page>
                        <page string="Social Log" name="social_log">
                            <div class="alert alert-info" role="alert"
                                 invisible="social_log_ids">
                                No social publish history yet. The log appears here after publishing.
                            </div>
                            <field name="social_log_ids" readonly="1" nolabel="1">
                                <list create="false" delete="false" edit="false">
                                    <field name="create_date" string="Sent At"/>
                                    <field name="channel"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'sent'"
                                           decoration-danger="status == 'error'"/>
                                    <field name="message" string="Details"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search view ───────────────────────────────────────────────────── -->
    <record id="view_news_post_search" model="ir.ui.view">
        <field name="name">news.post.search</field>
        <field name="model">news.post</field>
        <field name="arch" type="xml">
            <search string="Search News">
                <field name="name"/>
                <filter name="published"    string="Published"    domain="[('is_published','=',True)]"/>
                <filter name="unpublished"  string="Unpublished"  domain="[('is_published','=',False)]"/>
                <separator/>
                <filter name="type_news"          string="News"          domain="[('news_type','=','news')]"/>
                <filter name="type_announcements" string="Announcements" domain="[('news_type','=','announcements')]"/>
                <filter name="type_pre_releases"  string="Pre-releases"  domain="[('news_type','=','pre_releases')]"/>
                <separator/>
                <filter name="social_sent"     string="Social: Sent"     domain="[('social_status','=','sent')]"/>
                <filter name="social_error"    string="Social: Error"    domain="[('social_status','=','error')]"/>
                <filter name="social_not_sent" string="Social: Not sent" domain="[('social_status','=','not_sent')]"/>
            </search>
        </field>
    </record>

</odoo>
