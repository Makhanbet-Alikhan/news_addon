<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_social_preview_wizard_form" model="ir.ui.view">
        <field name="name">news.social.preview.wizard.form</field>
        <field name="model">news.social.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Publish to Social Media">
                <sheet>
                    <div class="oe_title">
                        <h1>📢 Publish to Social Media</h1>
                        <p class="text-muted">Review the caption and choose which channels to post to.</p>
                    </div>
                    <group>
                        <field name="post_id" readonly="1"/>
                        <field name="caption" widget="text" placeholder="Your post caption..."/>
                    </group>
                    <group string="Send to channels">
                        <field name="send_telegram"  widget="boolean_toggle"/>
                        <field name="send_facebook"  widget="boolean_toggle"/>
                        <field name="send_instagram" widget="boolean_toggle"/>
                        <field name="send_twitter"   widget="boolean_toggle"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_publish" type="object" string="Publish Now 🚀" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_social_preview_wizard" model="ir.actions.act_window">
        <field name="name">Publish to Social Media</field>
        <field name="res_model">news.social.preview.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_post_id': active_id}</field>
    </record>
</odoo>
