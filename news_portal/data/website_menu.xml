<?xml version="1.0" encoding="utf-8"?>
<!--
    Website menu items are created/translated via post_init_hook (hooks.py).
    This file only provides the fallback XML record for the main /news entry
    so that the module can install even without an active website.
    Translations (KZ/RU/EN) and the extra menu items (Announcements, Pre-releases)
    are always handled by the hook.
-->
<odoo>
    <data noupdate="1">
        <record id="website_menu_news" model="website.menu">
            <field name="name">News</field>
            <field name="url">/news</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">60</field>
        </record>
        <record id="website_menu_announcements" model="website.menu">
            <field name="name">Announcements</field>
            <field name="url">/announcements</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">61</field>
        </record>
        <record id="website_menu_pre_releases" model="website.menu">
            <field name="name">Pre-releases</field>
            <field name="url">/pre-releases</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">62</field>
        </record>
    </data>
</odoo>
